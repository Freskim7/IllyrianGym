#. translators: %1$s - Documentation URL.
#: src/Admin/Pages/MiscTab.php:421
msgid "Limit the number of emails this site will send in each time interval (per minute, hour, day, week and month). Emails that will cross those set limits will be queued and sent as soon as your limits allow. <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">Learn More</a>"
msgstr "Kufizoni numrin e email-eve që ky sajt do të dërgojë në çdo interval kohor (për minutë, orë, ditë, javë dhe muaj). Email-et që do të kapërcejnë këta kufij të vendosur do të vihen në radhë dhe dërgohen sapo ta lejojnë kufijtë tuaj. <a href=\"%1$s\" target=\"_blank\" rel=\"noopener noreferrer\">Mësoni Më Tepër</a>"

